{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the web radio app.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile photo URL."
        },
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["listener", "admin"],
          "description": "The user's role."
        }
      },
      "required": ["uid", "displayName", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message sent by a listener.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The content of the message."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who sent the message."
        },
        "userName": {
          "type": "string",
          "description": "The name of the user who sent the message."
        },
        "userPhoto": {
          "type": "string",
          "description": "The photo URL of the user who sent the message."
        },
        "createdAt": {
          "type": "timestamp",
          "description": "The time the message was sent."
        }
      },
      "required": ["text", "userId", "userName", "createdAt"]
    },
    "SongRequest": {
      "title": "SongRequest",
      "description": "A song request made by a listener.",
      "type": "object",
      "properties": {
        "songName": {
          "type": "string",
          "description": "The name of the requested song."
        },
        "artistName": {
          "type": "string",
          "description": "The name of the artist."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who requested the song."
        },
        "userName": {
          "type": "string",
          "description": "The name of the user who requested the song."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "played"],
          "description": "The status of the request."
        },
        "createdAt": {
          "type": "timestamp",
          "description": "The time the request was made."
        }
      },
      "required": ["songName", "artistName", "userId", "userName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and roles."
    },
    "/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Stores chat messages."
    },
    "/songRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/SongRequest"
      },
      "description": "Stores song requests."
    }
  }
}
